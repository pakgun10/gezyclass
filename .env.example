# GezyClass — Environment Configuration
# Copy to .env and adjust values
# cp .env.example .env

# PocketBase API URL (localhost, not exposed to internet)
PB_URL=http://127.0.0.1:8090

# PocketBase superadmin credentials (for AI Bot CRUD operations)
PB_SUPERUSER_EMAIL=gunanto1010@gmail.com
PB_SUPERUSER_PASSWORD=change-this-password

# Hugo paths
HUGO_CONTENT_PATH=gezyclass/hugo/content
HUGO_PUBLIC_PATH=gezyclass/public

# Optional: backup directory
BACKUP_DIR=gezyclass/backups
