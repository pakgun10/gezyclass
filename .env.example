# GezyClass — Environment Configuration
# Copy to .env and adjust values
# cp .env.example .env

# PocketBase API URL (localhost, not exposed to internet)
PB_URL=http://127.0.0.1:8090

# PocketBase superadmin credentials (for AI Bot CRUD operations)
PB_SUPERUSER_EMAIL=admin@gezyclass.web.id
PB_SUPERUSER_PASSWORD=change-this-password

# Hugo paths
HUGO_CONTENT_PATH=/var/www/class.gezytech.web.id/hugo/content
HUGO_PUBLIC_PATH=/var/www/class.gezytech.web.id/public

# Optional: backup directory
BACKUP_DIR=/var/www/class.gezytech.web.id/backups
