u"}, {"k": 0, "o": ["5", "1", "12", "7"], "q": "Jika $a = 3, b = 4$, maka $c = \\ldots$", "tp": "Menghitung sisi miring"}, {"k": 0, "o": ["segitiga siku-siku", "segitiga tumpul", "semua segitiga", "segitiga sama sisi"], "q": "Teorema Pythagoras berlaku pada ...", "tp": "Menjelaskan syarat berlakunya Pythagoras"}], "tp_bab": "Murid dapat menemukan hubungan sisi-sisi segitiga siku-siku (teorema Pythagoras)."}], "totalItems": 1}